# TLS and routing for the whole app. DOMAIN is e.g. studyroom.chanombude.me (or "localhost" to try
# it on this machine, where Caddy uses its own local certificates). Certificates are automatic.
{$DOMAIN} {
	encode zstd gzip
	# The REST API is same-origin with the site (no CORS; the admin cookie stays first-party)
	handle /api/* {
		reverse_proxy api:2568
	}
	handle {
		reverse_proxy web:3000
	}
}

game.{$DOMAIN} {
	# Prometheus scrapes /metrics and the API reads /internal/live inside the compose network;
	# neither is public
	@private path /metrics /internal/*
	handle @private {
		respond 404
	}
	reverse_proxy game:2567
}

rtc.{$DOMAIN} {
	reverse_proxy livekit:7880
}

grafana.{$DOMAIN} {
	reverse_proxy grafana:3000
}
