# Settings for infra/compose/compose.prod.yaml. On AWS the host writes .env.prod from SSM Parameter
# Store (generated by Terraform); to try the stack on this machine, copy to .env.prod (git-ignored).

# Public hostname; game., rtc. and grafana. are derived from it ("localhost" for a local trial)
DOMAIN=studyroom.chanombude.me

# Images: "<ecr-host>/chanom" on AWS, "chanom" for images built on this machine; and their tag
REGISTRY=chanom
TAG=local

# RDS on AWS; locally the dev Postgres: postgres://study:study@host.docker.internal:5433/study
DATABASE_URL=postgres://study:CHANGE_ME@your-rds-endpoint:5432/study?sslmode=require

# openssl rand -base64 24
ADMIN_PASSWORD=
GF_ADMIN_PASSWORD=

# LiveKit API key and secret (the secret needs 32+ characters)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Extra LiveKit flags; locally: --node-ip 127.0.0.1
LIVEKIT_ARGS=
