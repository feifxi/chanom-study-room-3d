          "refId": "A",
          "expr": "sum(rate(study_http_requests_total{route!~\"/metrics|/health|/api/health|/internal/live\",code=~\"5..\"}[$__rate_interval])) / sum(rate(study_http_requests_total{route!~\"/metrics|/health|/api/health|/internal/live\"}[$__rate_interval]))",
          "legendFormat": "5xx share",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
