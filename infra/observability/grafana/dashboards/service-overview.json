    {
      "type": "timeseries",
      "title": "Joins and disconnects / min",
      "id": 14,
      "description": "dropped = connection lost; reconnected = came back within 20 s; timed_out = never came back (burns the session SLO)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(study_joins_total[$__rate_interval])) * 60",
          "legendFormat": "joins",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (kind) (rate(study_disconnects_total[$__rate_interval])) * 60",
