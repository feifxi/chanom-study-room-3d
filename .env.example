# Copy to .env and adjust. Never commit real secrets.

# --- web (Next.js) ---
NEXT_PUBLIC_GAME_URL=http://localhost:2570

# --- game (Colyseus) ---
PORT=2570
WEB_ORIGIN=http://localhost:3100

# --- database (phase 2) ---
DATABASE_URL=postgres://study:study@localhost:5433/study

# --- auth: Better Auth (phase 2) ---
