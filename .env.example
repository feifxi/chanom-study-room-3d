# Copy to .env and adjust. Never commit real secrets.

# --- web (Next.js) ---
NEXT_PUBLIC_GAME_URL=http://localhost:2567

# --- game (Colyseus) ---
PORT=2567
WEB_ORIGIN=http://localhost:3000

# --- database: study stats, visits and feedback ---
DATABASE_URL=postgres://study:study@localhost:5433/study

# --- voice: LiveKit (dev server uses devkey/secret) ---
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- admin page (/admin) ---
# Required to open the admin page; leave empty to turn it off. `pnpm dev` defaults to "chanom-dev".
# Use a long random value in production (e.g. `openssl rand -base64 24`).
ADMIN_PASSWORD=
# Set when the game server sits behind a reverse proxy (e.g. Caddy) so rate limits see the real client IP.
# TRUST_PROXY=1
