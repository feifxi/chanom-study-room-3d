# Copy to .env for local development (cp .env.example .env). Never commit .env.
NODE_ENV=development
PORT=4000
# Where people open Connecta; the browser reaches the API through it (/api)
WEB_ORIGIN=http://localhost:3000
# Postgres from compose.yaml
DATABASE_URL=postgresql://connecta:connecta@localhost:5433/connecta
# debug | info | warn | error | silent
LOG_LEVEL=debug
# The live gateway (chat, presence): its own process, reached through the web app's /live
GATEWAY_PORT=4001
# Redis from compose.yaml: live events go from the API to the gateway through it
REDIS_URL=redis://localhost:6379

# Signs sessions. Any 32+ characters locally; a real random value elsewhere (openssl rand -base64 32)
AUTH_SECRET=local-development-secret-change-me-0000
# Signs join tickets for the game server: the same value goes in apps/game/.env
GAME_SECRET=local-game-secret-change-me-00000000000
# Optional locally: without them the Google and Discord buttons say they aren't set up.
# Redirect URIs to register: http://localhost:3000/api/auth/callback/google and .../discord
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email goes to Mailpit from compose.yaml: read it at http://localhost:8025
MAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Connecta <hello@connecta.local>

# The AWS Emulator from compose.yaml (production leaves these unset and uses AWS itself)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=https://127.0.0.1:9297
AWS_CA_BUNDLE=../../.local/aws-emulator/9297/ca.pem
S3_BUCKET=connecta-files
