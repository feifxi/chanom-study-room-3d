// The Connecta database. The API owns it: every change is a migration (pnpm db:migrate).
// Models arrive with the features that need them. Tables and columns are snake_case in Postgres;
// the client stays camelCase.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── Accounts (docs/v2/features/02-accounts.md) ──────────────────────────────────────────────────
// User, Session, Account and Verification are Better Auth's tables (its Prisma adapter reads and
// writes them; field names must match its schema). Connecta's own fields sit on User and are only
// written through the API's accounts module, never by Better Auth's update-user route.

/// A person: a full account, or a guest (isAnonymous) made from an invite that can sign up later.
model User {
  id                       String    @id
  /// Display name: up to 16 characters, not unique
  name                     String
  /// Guests get a placeholder address that never receives mail
  email                    String    @unique
  emailVerified            Boolean   @default(false) @map("email_verified")
  image                    String?
  isAnonymous              Boolean   @default(false) @map("is_anonymous")
  /// Unique @handle, lowercase. Null until sign-up is finished (and always for guests)
  handle                   String?   @unique
  handleChangedAt          DateTime? @map("handle_changed_at")
  /// The full date, never shown to anyone else. Null until sign-up is finished
  birthday                 DateTime? @db.Date
  /// The character (AvatarLook from @connecta/shared)
  look                     Json?
  /// Who can send a friend request: anyone, rooms (people who share a room) or nobody
  requestsFrom             String    @default("anyone") @map("requests_from")
  /// Friends see you as offline (and not in any room)
  appearOffline            Boolean   @default(false) @map("appear_offline")
  /// Friends see what you're doing ("Focusing · Calculus"), not only where
  showActivity             Boolean   @default(true) @map("show_activity")
  /// When you last went offline; the live state itself is in Redis (PresenceService)
  lastSeenAt               DateTime? @map("last_seen_at")
  /// Your browser's time zone (IANA), kept up to date by the web app: your focus days start at your midnight
  timeZone                 String    @default("UTC") @map("time_zone")
  /// Earned from daily quests, spent in the Shop; every change is a coin_entries row in the same transaction
  coins                    Int       @default(0)
  /// Connecta Plus runs until then (null or past: Free). Payments and gifts move it on
  plusUntil                DateTime? @map("plus_until")
  /// The last "Plus is ending" step done for this plus_until (soon, ended, graceSoon, over), as
  /// "<step>@<plus_until>": each step happens once, and a new date starts over
  plusNotice               String?   @map("plus_notice")
  /// On the Connecta team (feature 14): set by `pnpm --filter @connecta/api team <handle>`, never by the app
  team                     Boolean   @default(false)
  /// Suspended by the Connecta team until then: can't sign in (admin site)
  suspendedUntil           DateTime? @map("suspended_until")
  /// Banned by the Connecta team: can't sign in, no end
  bannedAt                 DateTime? @map("banned_at")
  /// Listed on the Everyone focus ranking; null = the default for your age (on 18+, off under 18)
  showOnEveryone           Boolean?  @map("show_on_everyone")
  /// Settings → Notifications: no game invite cards while your focus timer runs
  hideInvitesWhileFocusing Boolean   @default(false) @map("hide_invites_while_focusing")
  /// Asked to be deleted: goes at this time unless they sign in and keep it (7 days)
  deleteAt                 DateTime? @map("delete_at")
  /// Deleted: the row stays as "Deleted user" so their messages still read; everything personal is gone
  deletedAt                DateTime? @map("deleted_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  sessions         Session[]
  accounts         Account[]
  handleHolds      HandleHold[]
  memberships      Membership[]
  requests         JoinRequest[]
  bans             RoomBan[]         @relation("banned")
  guestPasses      GuestVisit[]
  accountActions   AccountAction[]   @relation("actionsOn")
  decks            RoomDeck[]
  friends          Friendship[]      @relation("friendOf")
  friendOf         Friendship[]      @relation("friend")
  sentRequests     FriendRequest[]   @relation("sent")
  receivedRequests FriendRequest[]   @relation("received")
  messages         Message[]
  reactions        Reaction[]
  blocks           Block[]           @relation("blocker")
  blockedBy        Block[]           @relation("blocked")
  pictures         Picture[]
  dmMembers        DmMember[]
  notifications    Notification[]
  focusSessions    FocusSession[]
  todos            Todo[]
  questProgress    QuestProgress[]
  coinEntries      CoinEntry[]
  ownedItems       OwnedItem[]
  plusSubscription PlusSubscription?
  checkouts        Checkout[]
  giftsReceived    Checkout[]        @relation("GiftTo")
  payments         Payment[]

  @@index([deleteAt])
  @@map("users")
}

/// A signed-in browser. The cookie holds only the token; deleting the row signs that browser out.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

/// A way to sign in, linked to a user: Google, Discord or email. One user can have several.
model Account {
  id                    String    @id
  /// The id at the provider (Google's or Discord's user id)
  accountId             String    @map("account_id")
  /// google, discord, credential
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

/// Short-lived secrets: email sign-in codes and OAuth state.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

/// Under 13: the sign-in and the browser wait a day before another birthday can be tried.
model AgeLock {
  /// "user:<id>" or "device:<id>"
  key   String   @id
  until DateTime

  @@map("age_locks")
}

/// An old @handle kept for its owner for 30 days after a change (or after deleting the account),
/// so nobody can grab it to pretend to be them. Its owner can take it back meanwhile.
model HandleHold {
  handle String   @id
  userId String   @map("user_id")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  until  DateTime

  @@index([userId])
  @@map("handle_holds")
}

// ── Rooms and membership (docs/v2/features/03-rooms-membership.md) ─────────────────────────────

enum Visibility {
  /// Invite only, not listed
  private
  /// Listed in Discover; mods let each new member in
  request
  /// Listed; anyone can join and walk in
  open
}

enum RoomRole {
  owner
  mod
  member
}

enum InviteKind {
  /// Whoever opens it joins the room
  member
  /// Walk in for 24 hours without joining (or without an account)
  guest
}

/// A room: one map, one permanent chat, its own members and rules. The top level: no servers.
model Room {
  /// Short and random, in the room's URL (/r/<id>)
  id               String     @id
  name             String
  emoji            String
  description      String     @default("")
  /// A template from @connecta/shared MAP_IDS
  mapId            String     @map("map_id")
  /// cosy or big (big needs the owner's Plus)
  size             String     @default("cosy")
  /// clock, day or night: the same for everyone inside
  time             String     @default("clock")
  visibility       Visibility @default(private)
  /// People inside at once, set lower than the plan allows; null means the plan's most
  capacity         Int?
  /// Up to 3 from ROOM_TAGS, for Discover
  tags             String[]   @default([])
  language         String?
  rules            String
  showRules        Boolean    @default(true) @map("show_rules")
  filterWords      Boolean    @default(true) @map("filter_words")
  slowMode         Boolean    @default(false) @map("slow_mode")
  newMemberWait    Boolean    @default(false) @map("new_member_wait")
  /// Off: nobody starts games that invite the whole room (Pick a Side)
  roomWideGames    Boolean    @default(true) @map("room_wide_games")
  membersCanInvite Boolean    @default(true) @map("members_can_invite")
  allowGuests      Boolean    @default(true) @map("allow_guests")
  guestVoice       Boolean    @default(false) @map("guest_voice")
  /// Who the owner picked to take over if their account is deleted
  heirId           String?    @map("heir_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  members  Membership[]
  requests JoinRequest[]
  bans     RoomBan[]
  focus    FocusSession[]
  invites  Invite[]
  guests   GuestVisit[]
  messages Message[]
  decks    RoomDeck[]

  @@index([visibility])
  @@map("rooms")
}

/// Someone in a room. Exactly one owner per room (the API keeps it that way).
model Membership {
  roomId        String    @map("room_id")
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          RoomRole  @default(member)
  joinedAt      DateTime  @default(now()) @map("joined_at")
  /// Last opened (its page or walking in), for Home's order
  visitedAt     DateTime? @map("visited_at")
  pinned        Boolean   @default(false)
  /// all, mentions or none: which chat messages notify you
  notify        String    @default("mentions")
  /// Can't talk or type until then
  timedOutUntil DateTime? @map("timed_out_until")
  /// The last room chat message you\'ve seen: "New messages" and the unread count start after it
  lastReadId    String?   @map("last_read_id")

  @@id([roomId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Ask to join. Letting someone in removes the row; a decline stays, so they wait 7 days to ask again.
model JoinRequest {
  roomId     String    @map("room_id")
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Set when declined
  declinedAt DateTime? @map("declined_at")

  @@id([roomId, userId])
  @@map("join_requests")
}

/// Banned from a room: removed, can't rejoin or use its guest passes. Tied to the account.
model RoomBan {
  roomId    String   @map("room_id")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation("banned", fields: [userId], references: [id], onDelete: Cascade)
  /// Who banned them (kept as an id: the mod may leave)
  byId      String   @map("by_id")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@id([roomId, userId])
  @@map("room_bans")
}

/// An invite link: /i/<code> (member) or /g/<code> (guest pass). No use limits.
model Invite {
  code        String     @id
  roomId      String     @map("room_id")
  room        Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  kind        InviteKind
  createdById String     @map("created_by_id")
  /// 1d, 7d or never (member invites); guest passes are always 24 hours
  expiry      String
  uses        Int        @default(0)
  expiresAt   DateTime?  @map("expires_at")
  cancelledAt DateTime?  @map("cancelled_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([roomId])
  @@map("invites")
}

/// Someone let in by a guest pass: they may walk into this one room until the pass runs out.
model GuestVisit {
  roomId String   @map("room_id")
  room   Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String   @map("user_id")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  until  DateTime

  @@id([roomId, userId])
  @@map("guest_visits")
}

// ── Friends (docs/v2/features/05-friends.md) ───────────────────────────────────────────────────

/// A friendship is two rows, one each way, so "my friends" is one simple lookup.
model Friendship {
  userId   String   @map("user_id")
  user     User     @relation("friendOf", fields: [userId], references: [id], onDelete: Cascade)
  friendId String   @map("friend_id")
  friend   User     @relation("friend", fields: [friendId], references: [id], onDelete: Cascade)
  since    DateTime @default(now())

  @@id([userId, friendId])
  @@index([friendId])
  @@map("friendships")
}

/// A friend request. Ignoring just leaves it to expire (30 days); nobody is told.
model FriendRequest {
  fromId    String    @map("from_id")
  from      User      @relation("sent", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String    @map("to_id")
  to        User      @relation("received", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  /// Ignored by the receiver: gone from their list, still "Pending" for the sender until it expires
  ignoredAt DateTime? @map("ignored_at")

  @@id([fromId, toId])
  @@index([toId])
  @@map("friend_requests")
}

/// Blocked: no requests or DMs from them, and their room messages fold away (feature 4).
model Block {
  userId    String   @map("user_id")
  user      User     @relation("blocker", fields: [userId], references: [id], onDelete: Cascade)
  blockedId String   @map("blocked_id")
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

// ── Chat (docs/v2/features/04-chat-and-dms.md) ─────────────────────────────────────────────────

/// A chat message. Ids are UUIDv7, so they sort by time: pages, read markers and unread counts
/// compare ids. A message is in a room's chat or in a DM (exactly one of the two).
model Message {
  id           String     @id @default(uuid(7))
  roomId       String?    @map("room_id")
  room         Room?      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  dmId         String?    @map("dm_id")
  dm           Dm?        @relation(fields: [dmId], references: [id], onDelete: Cascade)
  authorId     String     @map("author_id")
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text         String
  /// text, or a card in a DM: ask (asking to join the other person's room) or invite (a link to one)
  kind         String     @default("text")
  /// The card's details (room, invite code, answer); null for text
  card         Json?
  replyToId    String?    @map("reply_to_id")
  replyTo      Message?   @relation("replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]  @relation("replies")
  /// Who it @mentions (user ids, members only), and whether it pings the whole room
  mentions     String[]
  mentionsRoom Boolean    @default(false) @map("mentions_room")
  createdAt    DateTime   @default(now()) @map("created_at")
  editedAt     DateTime?  @map("edited_at")
  /// Deleted messages keep their row (text emptied) so replies can say the original is gone
  deletedAt    DateTime?  @map("deleted_at")
  /// False while its pictures are still being shrunk and checked: only the author sees it until then
  ready        Boolean    @default(true)
  pictures     Picture[]
  reactions    Reaction[]

  @@index([roomId, id])
  @@index([dmId, id])
  @@map("messages")
}

/// A 1-to-1 chat between two people (friends to send; the history stays if they stop being).
/// Made when the first message is sent, so opening an empty one leaves no trace.
model Dm {
  id        String     @id @default(uuid(7))
  /// The two user ids, sorted and joined with ":", so each pair has one DM
  pair      String     @unique
  /// The newest message's id, to sort the list
  lastId    String?    @map("last_id")
  createdAt DateTime   @default(now()) @map("created_at")
  members   DmMember[]
  messages  Message[]

  @@map("dms")
}

model DmMember {
  dmId       String  @map("dm_id")
  dm         Dm      @relation(fields: [dmId], references: [id], onDelete: Cascade)
  userId     String  @map("user_id")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The newest message you've seen: drives "New messages" and unread counts, never shown to them
  lastReadId String? @map("last_read_id")
  /// Muted: not in the Messages badge and no toasts in a room (the chat still shows its unread)
  muted      Boolean @default(false)

  @@id([dmId, userId])
  @@index([userId])
  @@map("dm_members")
}

/// A picture in a message (up to 4). The browser uploads the original straight to S3
/// (uploads/<id>); the pictures worker shrinks it to WebP (pictures/<id>.webp), checks it, and
/// removes the original. Attached to a message when it's sent; never-sent ones go after a day.
model Picture {
  id         String   @id @default(uuid(7))
  uploaderId String   @map("uploader_id")
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  messageId  String?  @map("message_id")
  message    Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// uploading, processing, ready or failed
  status     String   @default("uploading")
  /// The WebP's key, once it's ready
  key        String?
  width      Int      @default(0)
  height     Int      @default(0)
  bytes      Int      @default(0)
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@index([uploaderId, createdAt])
  @@map("pictures")
}

model Reaction {
  messageId String   @map("message_id")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  @@id([messageId, userId, emoji])
  @@map("reactions")
}

// ── Inbox (docs/v2/features/01-app-shell.md#-inbox) ───────────────────────────────────────────

/// One item in the 🔔 inbox. Kept 30 days.
model Notification {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// friend_request, friend_accepted, join_request, joined, mention, messages
  kind      String
  /// What the item shows and opens: text (with **bold**), href, person, room…
  payload   Json
  /// Items that pile up into one while unread ("5 new messages in Chanom Friends")
  groupKey  String?   @map("group_key")
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  @@index([userId, createdAt])
  @@index([userId, groupKey])
  @@index([createdAt])
  @@map("notifications")
}

/// A finished focus round (feature 8): timed by the game server, saved by the API's focus worker.
/// Members only; guests' rounds are never saved.
model FocusSession {
  /// The game server's round id, so a retried job saves it once
  id        String   @id
  userId    String   @map("user_id")
  /// Null once the room is deleted: your minutes stay yours
  roomId    String?  @map("room_id")
  subject   String   @default("")
  startedAt DateTime @map("started_at")
  endedAt   DateTime @map("ended_at")
  minutes   Int
  /// The day it counts for, in your own time zone when it started (the 12-hour cap is per day)
  day       DateTime @db.Date

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  /// A round counts for the day (and week) it started in
  @@index([userId, startedAt])
  @@index([roomId, startedAt])
  @@index([startedAt])
  @@map("focus_sessions")
}

/// The to-do list (feature 8): one per account, private, the same in every room. Up to 50 items;
/// done ones clear themselves after 7 days.
model Todo {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  text      String
  done      Boolean   @default(false)
  doneAt    DateTime? @map("done_at")
  /// Order in the list: new items go last
  position  Int
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@index([doneAt])
  @@map("todos")
}

/// Pick a Side's own decks (feature 11): written by a room's members, used by anyone who hosts there
model RoomDeck {
  id        String   @id @default(uuid(7))
  roomId    String   @map("room_id")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  /// Who wrote it; null once their account is gone (the deck stays with the room)
  authorId  String?  @map("author_id")
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  name      String
  /// opinion (Would you rather: 2 answers) or quiz (4 answers, one right)
  kind      String
  /// [{ q, answers, right? }], checked against @connecta/shared/pick-a-side's limits
  questions Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roomId])
  @@map("room_decks")
}

/// A person's progress on one of their quests for a day (spec 15): the day's three come from
/// questsFor in @connecta/shared, so only progress is stored
model QuestProgress {
  userId   String    @map("user_id")
  /// The day, in their own time zone
  day      DateTime  @db.Date
  questId  String    @map("quest_id")
  progress Int       @default(0)
  /// When it paid out: once
  paidAt   DateTime? @map("paid_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, questId])
  @@index([day])
  @@map("quest_progress")
}

/// Every coin earned or spent; users.coins is the balance, changed in the same transaction
model CoinEntry {
  id        String   @id @default(uuid(7))
  userId    String   @map("user_id")
  /// + earned, - spent
  amount    Int
  /// quest:<id> when earned (the Shop adds its own)
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("coin_entries")
}

/// A Shop item you bought (an id from SHOP_ITEMS in @connecta/shared/shop); yours for good
model OwnedItem {
  userId   String   @map("user_id")
  itemId   String   @map("item_id")
  /// A pet's name, chosen when it was bought (null for everything else)
  name     String?
  boughtAt DateTime @default(now()) @map("bought_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@map("owned_items")
}

// ── Plus (docs/v2/features/15-business-infra.md#paying-stripe) ────────────────────────────────────

/// Your Plus plan: how it's paid and whether it renews. users.plus_until is what counts for perks
model PlusSubscription {
  userId               String   @id @map("user_id")
  /// monthly | yearly
  plan                 String
  /// card (renews by itself) | promptpay (renews by reminder)
  method               String
  /// false once cancelled: Plus runs to plus_until, then ends
  renews               Boolean  @default(true)
  stripeCustomerId     String?  @map("stripe_customer_id")
  stripeSubscriptionId String?  @unique @map("stripe_subscription_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plus_subscriptions")
}

/// A payment started from the payment page, paid once (Stripe's webhook, or the local stand-in)
model Checkout {
  id              String    @id @default(uuid(7))
  userId          String    @map("user_id")
  plan            String
  method          String
  /// open | paid
  status          String    @default("open")
  stripeSessionId String?   @unique @map("stripe_session_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  paidAt          DateTime? @map("paid_at")
  /// Gift Plus: the friend it's for (plan is "gift"), how long, and the note on the card
  giftToId        String?   @map("gift_to_id")
  giftMonths      Int?      @map("gift_months")
  giftNote        String?   @map("gift_note")

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  giftTo User? @relation("GiftTo", fields: [giftToId], references: [id], onDelete: Cascade)

  @@index([userId, giftToId])
  @@map("checkouts")
}

/// Money in: receipts in Settings → Plus & billing, and the admin site's money page. Kept when an
/// account is deleted (the books need them)
model Payment {
  id        String   @id @default(uuid(7))
  userId    String?  @map("user_id")
  /// "Plus · Monthly"
  what      String
  /// In baht
  amount    Int
  method    String
  /// Stripe's invoice or checkout session id (or local:<checkout>): a notice delivered twice pays once
  ref       String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("payments")
}

/// A report for the Connecta team (feature 14); a room's mods never see these. Ids are plain strings so
/// a report outlives the message, room or account it points at.
model Report {
  id          String   @id @default(uuid(7))
  /// person, message or room
  kind        String
  /// Who's reported: the person, or the message's author; null for a room
  userId      String?  @map("user_id")
  messageId   String?  @map("message_id")
  /// Where: a room's id, a Common copy's (common-cafe-2), or null in a DM
  place       String?
  dmId        String?  @map("dm_id")
  reason      String
  details     String   @default("")
  reporterId  String   @map("reporter_id")
  /// Counted toward the automatic steps (accounts only, once per reporter in a window)
  counted     Boolean  @default(false)
  /// What the automatic steps did when this report tipped it: muted (15 min in a room) or common_out (1 h)
  step        String?
  /// What the team needs to judge it: names, the message, what was said around it
  context     Json
  /// open until the team decides (the admin site)
  status      String   @default("open")
  outcome     String?
  decidedById String?  @map("decided_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([userId])
  @@map("reports")
}

/// What the Connecta team did to an account (admin site): warn, suspend, ban, lift, reset_name. Each
/// is emailed to the account with its reason; they reply to appeal.
model AccountAction {
  id        String    @id @default(uuid(7))
  userId    String    @map("user_id")
  user      User      @relation("actionsOn", fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  /// A suspension's end
  until     DateTime?
  reason    String
  byId      String    @map("by_id")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("account_actions")
}

/// Every team action and automatic step, kept a year, read-only (admin site). Plain ids, so it
/// outlives what it names.
model AuditEntry {
  id         String   @id @default(uuid(7))
  /// The team member, or null for an automatic step
  byId       String?  @map("by_id")
  /// e.g. account.suspend, common.remove, report.step
  action     String
  targetKind String   @map("target_kind")
  targetId   String   @map("target_id")
  reason     String   @default("")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetKind, targetId])
  @@map("audit_log")
}
