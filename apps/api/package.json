{
  "name": "@study/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-postgres://study:study@localhost:5433/study} ADMIN_PASSWORD=${ADMIN_PASSWORD:-chanom-dev} LOG_FILE=${LOG_FILE:-logs/api.log} tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "stats-check": "tsx scripts/stats-check.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@study/db": "workspace:^",
    "@study/shared": "workspace:^",
    "hono": "^4.13.16",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
