{
  "name": "@connecta/game",
  "version": "0.0.0",
  "private": true,
  "description": "Connecta's game server (Colyseus): one room per Connecta room, movement, seats; voice tokens and NPCs later in step 4.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/schema": "^5",
    "@connecta/shared": "workspace:*",
    "colyseus": "^0.18",
    "dotenv": "^17",
    "ioredis": "^6",
    "jose": "^6.2.18",
    "pino": "^10",
    "zod": "^4"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18",
    "@types/node": "^24",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "vitest": "^5"
  }
}
