# Copy to .env. The game server needs only these; the defaults suit local development.
PORT=4002
REDIS_URL=redis://localhost:6379
# The same value as GAME_SECRET in apps/api/.env (32+ random characters: openssl rand -base64 32)
GAME_SECRET=local-game-secret-change-me-00000000000
# Voice: the compose LiveKit (its dev keys); browsers connect to LIVEKIT_PUBLIC_URL
LIVEKIT_URL=http://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
