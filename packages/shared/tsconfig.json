{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Built to dist/ so Node (the API, later the game server) can run it; relative imports end in .js
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/test-fixtures.ts"]
}
