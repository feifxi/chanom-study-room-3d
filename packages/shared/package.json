{
  "name": "@connecta/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Types and rules shared by the web app, the API and the game server: avatars, maps, movement, navigation.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./maps": {
      "types": "./dist/maps/index.d.ts",
      "default": "./dist/maps/index.js"
    },
    "./maps/*": {
      "types": "./dist/maps/*.d.ts",
      "default": "./dist/maps/*.js"
    },
    "./chess": {
      "types": "./dist/chess.d.ts",
      "default": "./dist/chess.js"
    },
    "./slave": {
      "types": "./dist/slave.d.ts",
      "default": "./dist/slave.js"
    },
    "./pick-a-side": {
      "types": "./dist/pickASide.d.ts",
      "default": "./dist/pickASide.js"
    },
    "./draw-guess": {
      "types": "./dist/drawGuess.d.ts",
      "default": "./dist/drawGuess.js"
    },
    "./quests": {
      "types": "./dist/quests.d.ts",
      "default": "./dist/quests.js"
    },
    "./shop": {
      "types": "./dist/shop.d.ts",
      "default": "./dist/shop.js"
    },
    "./plus": {
      "types": "./dist/plus.d.ts",
      "default": "./dist/plus.js"
    },
    "./moderate": {
      "types": "./dist/moderate.d.ts",
      "default": "./dist/moderate.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "chess.js": "^1.4.0",
    "obscenity": "^0.4.6"
  }
}
