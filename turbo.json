{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "WEB_ORIGIN",
        "DATABASE_URL",
        "ADMIN_PASSWORD",
        "TRUST_PROXY",
        "API_DEV_URL",
        "GAME_INTERNAL_URL",
        "LIVEKIT_*",
        "LOG_*",
        "CHAOS_*",
        "NEXT_PUBLIC_*"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^typecheck"]
    }
  }
}
