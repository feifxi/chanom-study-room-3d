{
  "name": "demo-chanom-study-room",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @study/db generate",
    "db:migrate": "pnpm --filter @study/db migrate",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run typecheck lint test",
    "e2e": "pnpm --filter @study/web e2e",
    "obs:up": "docker compose --profile observability up -d",
    "obs:down": "docker compose --profile observability stop prometheus alertmanager loki alloy grafana",
    "infra:up": "bash infra/scripts/up.sh",
    "infra:down": "bash infra/scripts/down.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "prettier": "^3.9.10",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
