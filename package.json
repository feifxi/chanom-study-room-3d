{
  "name": "connecta",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "pnpm format:check && turbo run typecheck lint test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @connecta/api db:migrate",
    "db:seed": "pnpm --filter @connecta/api db:seed",
    "db:reset": "pnpm --filter @connecta/api db:reset",
    "api:client": "pnpm --filter @connecta/api openapi && pnpm --filter @connecta/web api:types",
    "db:studio": "pnpm --filter @connecta/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "prettier": "^3.9.10",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
